{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "infrared chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "managementCluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        }
      },
      "required": [
        "name"
      ]
    },
    "externalURL": {
      "type": "string",
      "pattern": "^(https?://.+)?$"
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the operator writes to the Installation while each field is empty.",
      "properties": {
        "edge": {
          "type": "string",
          "enum": [
            "",
            "traefik",
            "gateway"
          ],
          "description": "spec.edge (INFRARED_EDGE); empty means traefik."
        },
        "previews": {
          "type": "object",
          "additionalProperties": false,
          "description": "spec.previews (INFRARED_PREVIEWS, as JSON); empty leaves previews to a person.",
          "properties": {
            "domain": {
              "type": "string",
              "minLength": 1,
              "description": "Zone z answers at https://<z>.<domain>."
            },
            "signInURL": {
              "type": "string",
              "pattern": "^https://",
              "description": "Infrared's public URL, where preview visitors sign in."
            },
            "ingressHost": {
              "type": "string",
              "description": "The name customers point their own domains at with a CNAME."
            },
            "ingressIP": {
              "type": "string",
              "description": "The ingress's public address, for A records on root domains."
            },
            "managedRoots": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Domains Infrared manages in Cloudflare, under which any org can claim a subdomain."
            },
            "cloudflareTokenSecret": {
              "type": "string",
              "description": "A Secret in the release namespace whose api-token key may edit DNS for the managed roots."
            }
          },
          "anyOf": [
            {
              "maxProperties": 0
            },
            {
              "required": [
                "domain",
                "signInURL"
              ]
            }
          ]
        }
      }
    },
    "cloud": {
      "type": "string",
      "enum": [
        "",
        "gcp",
        "aws"
      ],
      "description": "The control plane's cloud: picks the default image registry and chart repository (ADR 0033); empty is gcp."
    },
    "gitops": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "templateVersion": {
          "type": "string",
          "pattern": "^(v[0-9]+\\.[0-9]+\\.[0-9]+.*|[0-9a-f]{40})$",
          "description": "A tag of infrared-gitops-template, or a full 40-character commit SHA."
        },
        "chartRepository": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+(:[0-9]{1,5})?(/[a-z0-9]+([._-][a-z0-9]+)*)+$",
          "description": "The OCI repository of this chart, host and path with no oci://, tag or trailing slash (INFRARED_CHART_REPO); empty for the cloud's."
        }
      },
      "required": [
        "chartRepository",
        "templateVersion"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string",
          "description": "Registry prefix of every component image; empty for the cloud's default."
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "registry"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "imageCredentials": {
      "type": "object",
      "additionalProperties": false,
      "description": "The Secret named by imagePullSecrets[0], rendered when username and password are set.",
      "properties": {
        "registry": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?(:[0-9]+)?$",
          "description": "Registry host the credential is for."
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string",
          "description": "Pass it with --set-file; surrounding whitespace is trimmed."
        }
      }
    },
    "registryToken": {
      "type": "object",
      "additionalProperties": false,
      "description": "The registry token: a Google service account's access token for a private Artifact Registry (Workload Identity, no key), or ECR's token as an IAM role, written to the Secret registry-token every 30 minutes.",
      "properties": {
        "gcpServiceAccount": {
          "type": "string",
          "pattern": "^$|^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$",
          "description": "The Google service account, <name>@<project>.iam.gserviceaccount.com; empty for none."
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "region": {
              "type": "string",
              "pattern": "^$|^[a-z]{2}(-gov)?-[a-z]+-[0-9]$",
              "description": "The ECR region; empty for no ECR token."
            },
            "roleArn": {
              "type": "string",
              "pattern": "^$|^arn:aws(-[a-z]+)?:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]{1,512}$",
              "description": "An IAM role for IRSA on EKS; empty for the node's role."
            },
            "hostNetwork": {
              "type": "boolean",
              "description": "Run the Job on the host's network, for nodes whose instance metadata answers one hop."
            }
          },
          "required": [
            "region",
            "roleArn",
            "hostNetwork"
          ]
        },
        "registry": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+(:[0-9]{1,5})?$",
          "description": "The registry host the token is for; empty for image.registry's host."
        },
        "image": {
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$",
          "description": "The Job's image, with curl, jq, kubectl and the AWS CLI, by digest."
        }
      },
      "required": [
        "gcpServiceAccount",
        "aws",
        "registry",
        "image"
      ]
    },
    "cloudIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gcpServiceAccount": {
          "type": "string",
          "pattern": "^$|^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roleARN": {
              "type": "string",
              "pattern": "^$|^arn:aws[a-z-]*:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]{1,512}$"
            },
            "hostNetwork": {
              "type": "boolean"
            },
            "webIdentity": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "platformTokens": {
      "type": "object",
      "additionalProperties": false,
      "description": "Secret infrared-platform-tokens, rendered when a token is set, or with codeIndex.enabled the code index's record.",
      "properties": {
        "cloudflareApiToken": {
          "type": "string",
          "description": "Key cloudflare-api-token. Pass it with --set-file; surrounding whitespace is trimmed."
        },
        "backupAccessKeyId": {
          "type": "string",
          "description": "Key backup-access-key-id, with backupSecretAccessKey; refused with Google Cloud Storage, which takes no key. Pass it with --set-file; surrounding whitespace is trimmed."
        },
        "backupSecretAccessKey": {
          "type": "string",
          "description": "Key backup-secret-access-key, with backupAccessKeyId. Pass it with --set-file; surrounding whitespace is trimmed."
        },
        "codeIndexGithubAppId": {
          "type": "string",
          "description": "Key code-index-github-app-id: the code index's GitHub App's ID, a number, with codeIndexGithubAppInstallationId and codeIndexGithubAppPrivateKey, and only with codeIndex.enabled. Pass it with --set-file or --set-string; surrounding whitespace is trimmed."
        },
        "codeIndexGithubAppInstallationId": {
          "type": "string",
          "description": "Key code-index-github-app-installation-id: the ID of that App's installation, a number, with the other two. Pass it with --set-file or --set-string; surrounding whitespace is trimmed."
        },
        "codeIndexGithubAppPrivateKey": {
          "type": "string",
          "description": "Key code-index-github-app-private-key: that App's private key, PEM, with the other two. Pass it with --set-file; surrounding whitespace is trimmed."
        },
        "existingSecret": {
          "type": "string",
          "enum": [
            "",
            "infrared-platform-tokens"
          ],
          "description": "infrared-platform-tokens when it already exists; the chart then renders none."
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "description": "Setup token; empty generates one."
        },
        "existingSecret": {
          "type": "string",
          "description": "Name of an existing Secret; when set the chart renders none."
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "description": "Session key; empty generates one."
        },
        "existingSecret": {
          "type": "string",
          "description": "Name of an existing Secret; when set the chart renders none."
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            }
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extraRules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      },
      "required": [
        "image",
        "replicas",
        "resources",
        "service"
      ]
    },
    "api": {
      "$ref": "#/$defs/component"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            }
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "extensions": {
          "type": "array",
          "description": "Extensions the UI shows in its rail and proxies at /ext/<id>/<path>/; empty leaves the slot off.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,30}$",
                "description": "Names the routes /x/<id>/ and /ext/<id>/; '-' becomes '_' in nginx names."
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Rail label."
              },
              "icon": {
                "type": "string",
                "enum": [
                  "puzzle",
                  "book",
                  "wallet",
                  "receipt",
                  "users",
                  "key",
                  "landmark",
                  "scroll"
                ],
                "description": "Rail icon; default puzzle."
              },
              "upstream": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)+:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                "description": "host:port of the extension's Service; the host is a fully qualified name (it contains a dot), e.g. ledger.ledger.svc.cluster.local:8080."
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
                },
                "description": "First path segments proxied from /ext/<id>/<path>/ to <upstream>/<path>/; default [v1, ui]."
              },
              "entry": {
                "type": "string",
                "pattern": "^(/ext/[a-z][a-z0-9-]{1,30}/ui(/[A-Za-z0-9_~-][A-Za-z0-9._~-]*)+)?$",
                "description": "Absolute path of the remote module under /ext/<id>/ui/; empty means /ext/<id>/ui/entry.js."
              }
            },
            "required": [
              "id",
              "title",
              "upstream"
            ]
          }
        },
        "extensionsProxySecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string",
              "description": "Secret whose value the UI sends to extension upstreams as X-Infrared-Proxy-Secret; required when extensions is not empty."
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "image",
        "replicas",
        "resources",
        "service"
      ]
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            }
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "token": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "image",
        "replicas",
        "resources",
        "service"
      ]
    },
    "builds": {
      "type": "object",
      "additionalProperties": false,
      "description": "Product builds with kpack.",
      "properties": {
        "registry": {
          "type": "string",
          "description": "Registry prefix product images are built into; empty disables the builds component."
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "description": "The install's own registry (Zot).",
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?)?$",
          "description": "Host and port builds and nodes reach the registry at, no scheme (INFRARED_REGISTRY); empty means none."
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "description": "Zot's garbage collection and retention (INFRARED_REGISTRY_RETENTION, as JSON); each empty field keeps the template's default.",
          "properties": {
            "untaggedAfter": {
              "type": "string",
              "pattern": "^(([0-9]+(h|m|s))+)?$",
              "description": "An untagged image goes this long after it was untagged, e.g. 48h; empty: 24h."
            },
            "keepTags": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[ -~]{1,200}$"
              },
              "description": "Regular expressions; a tag matching one is kept. Empty: [\"^v[0-9]\"]."
            },
            "keepNewest": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "description": "Each repository's newest tags kept besides; 0: 10."
            },
            "gcInterval": {
              "type": "string",
              "pattern": "^(([0-9]+(h|m|s))+)?$",
              "description": "How often garbage is collected; empty: 1h."
            },
            "gcDelay": {
              "type": "string",
              "pattern": "^(([0-9]+(h|m|s))+)?$",
              "description": "How long after its last use a blob may be collected; empty: 1h."
            }
          }
        }
      }
    },
    "stores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Install the platform's stores through the gitops template (INFRARED_STORES)."
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "description": "The install's backups, which seed the Installation's spec.backup once, while it is empty: the bucket (INFRARED_BACKUP, as JSON), all three of bucket, endpoint and region or none, and a prefix only with them; the rest (INFRARED_COPIES, as JSON).",
      "properties": {
        "bucket": {
          "type": "string",
          "pattern": "^([a-z0-9][a-z0-9.-]{1,61}[a-z0-9])?$",
          "description": "Bucket name: 3 to 63 lowercase letters, digits, dots and hyphens."
        },
        "endpoint": {
          "type": "string",
          "pattern": "^(https://[^/?#@\\s]+/?)?$",
          "description": "The bucket's S3 endpoint: https:// and a host, no path; https://storage.googleapis.com for Google Cloud Storage, reached keyless by the Jobs' ServiceAccounts."
        },
        "region": {
          "type": "string",
          "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?)?$",
          "description": "The region S3 requests are signed for, e.g. us-east-1; for Google Cloud Storage the bucket's location, e.g. us-central1."
        },
        "prefix": {
          "type": "string",
          "pattern": "^([a-z0-9][a-z0-9._-]{0,62})?$",
          "description": "The path everything is kept under in the bucket: 1 to 63 lowercase letters, digits, dots, underscores and hyphens; empty: managementCluster.name."
        },
        "schedule": {
          "type": "string",
          "pattern": "^([0-9A-Za-z*/,?-]+( [0-9A-Za-z*/,?-]+){4})?$",
          "description": "A backup, by the operator's CronJob infrared-backup: five cron fields, UTC; empty keeps 5 * * * *."
        },
        "mirror": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schedule": {
              "type": "string",
              "pattern": "^([0-9A-Za-z*/,?-]+( [0-9A-Za-z*/,?-]+){4})?$",
              "description": "The buckets' mirror to the backup bucket: five cron fields, UTC; empty keeps 17 * * * *."
            }
          }
        },
        "retention": {
          "type": "string",
          "pattern": "^([1-9][0-9]{0,2}d)?$",
          "description": "How long each backup, and what the mirror replaced or deleted, is kept: whole days such as 7d; empty keeps 7d."
        },
        "recipients": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^age1[02-9ac-hj-np-z]{58}$"
          },
          "description": "age X25519 recipients (age1...), public keys only, each backup is encrypted to. Empty makes no backup."
        },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "archive": {
              "type": "boolean",
              "description": "Barman's WAL archive of the platform's Postgres in the backup bucket, besides the dump in each backup; off by default."
            }
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "bucket": {
              "const": ""
            },
            "endpoint": {
              "const": ""
            },
            "region": {
              "const": ""
            }
          }
        },
        {
          "properties": {
            "bucket": {
              "minLength": 1
            },
            "endpoint": {
              "minLength": 1
            },
            "region": {
              "minLength": 1
            }
          },
          "required": [
            "bucket",
            "endpoint",
            "region"
          ]
        }
      ],
      "if": {
        "properties": {
          "prefix": {
            "minLength": 1
          }
        },
        "required": [
          "prefix"
        ]
      },
      "then": {
        "properties": {
          "bucket": {
            "minLength": 1
          }
        },
        "required": [
          "bucket"
        ]
      }
    },
    "restore": {
      "type": "object",
      "additionalProperties": false,
      "description": "Restore at install from one of the backup bucket's backups (INFRARED_RESTORE).",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Restore this install; needs stores.enabled and a backup bucket, and with Gitea gitea.replicaCount 0."
        },
        "from": {
          "type": "string",
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$",
          "description": "The newest complete backup at or before this time is restored, RFC 3339 in UTC; empty, with no point: the newest."
        },
        "point": {
          "type": "string",
          "pattern": "^([0-9]{8}T[0-9]{6}Z)?$",
          "description": "Exactly this backup is restored, by its stamp, such as 20261006T010500Z; not with from."
        },
        "postgresImage": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/:-]*:[A-Za-z0-9._-]+@sha256:[0-9a-f]{64}$",
          "description": "The restore Job's Postgres sidecar, which restores each consumer database's dump: the image the gitops template's Postgres Cluster runs, as name:tag@sha256:digest."
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disabled": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          },
          "description": "The gitops template's components the install leaves out, by name (INFRARED_DISABLED_COMPONENTS, as JSON)."
        }
      }
    },
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "testActors": {
          "type": "boolean",
          "description": "Agent Substrate's test actors, counter-v1 and sandbox-v1. False, with stores.enabled and registry.address, names substrate-test-actors among the components left out (INFRARED_DISABLED_COMPONENTS)."
        }
      }
    },
    "codeIndex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Infrared's code index, which the gitops template runs in the namespace code-index. On, its image is handed to the operator among Infrared's own (INFRARED_IMAGES, code-index); it needs image.registry other than the default."
        },
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "description": "The code index's record, which the install writes into infrared-platform-tokens with codeIndex.enabled (keys code-index-knowledge-url and code-index-knowledge-ref) and the gitops template copies to code-index/code-index-settings.",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(https?://[^\\s]+)?$",
              "description": "The knowledge repository's URL, https:// or http://. Required with codeIndex.enabled wherever the chart renders infrared-platform-tokens."
            },
            "ref": {
              "type": "string",
              "pattern": "^([^\\s:^~?*\\[\\\\-][^\\s:^~?*\\[\\\\]*)?$",
              "description": "The branch, tag or commit to read it at; empty means main. No leading -, and none of whitespace, : ^ ~ ? * [ or \\, which the code index refuses."
            }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tag": {
              "type": "string",
              "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$",
              "description": "The tag of <image.registry>/infrared-codeindex, e.g. one-install-<short sha>."
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$",
              "description": "Its digest, sha256:...; empty pins by the tag alone."
            }
          }
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "goToolchainImage": {
          "type": "string",
          "minLength": 1
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Fence runner pods with a NetworkPolicy."
            },
            "extraEgressCIDRs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
              },
              "description": "Private CIDRs runners may reach over HTTP(S)."
            }
          }
        },
        "helmImage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metricsURL": {
          "type": "string"
        }
      }
    },
    "giteaAdmin": {
      "type": "object",
      "additionalProperties": false,
      "description": "Secret infrared-gitea-admin, Gitea's site admin, rendered once when gitea.enabled.",
      "properties": {
        "existingSecret": {
          "type": "string",
          "enum": [
            "",
            "infrared-gitea-admin"
          ],
          "description": "infrared-gitea-admin when it already exists; the chart then renders none."
        }
      }
    },
    "gitea": {
      "type": "object",
      "description": "Gitea: the gitea chart's own values, preset for one pod. gitea.enabled turns it on.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Run Gitea, and hand its address (INFRARED_GITEA_URL) and admin Secret (INFRARED_GITEA_ADMIN_SECRET) on."
        },
        "fullnameOverride": {
          "const": "gitea",
          "description": "Fixed: the Service the operator and the API reach is gitea-http."
        },
        "service": {
          "type": "object",
          "properties": {
            "http": {
              "type": "object",
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "storageClass": {
              "type": [
                "string",
                "null"
              ],
              "description": "StorageClass of Gitea's volume; empty uses the cluster's default."
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi|Ti)$",
              "description": "Size of Gitea's volume, e.g. 10Gi."
            }
          }
        },
        "gitea": {
          "type": "object",
          "properties": {
            "admin": {
              "type": "object",
              "properties": {
                "existingSecret": {
                  "const": "infrared-gitea-admin",
                  "description": "Fixed: Gitea reads its admin from the Secret giteaAdmin describes."
                }
              }
            }
          }
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "description": "One pod, or none: 0 while a restore fills Gitea's volume."
        }
      }
    },
    "summaryvideo": {
      "type": "object",
      "additionalProperties": false,
      "description": "Summary videos of Changes.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          }
        },
        "browserImage": {
          "type": "string"
        },
        "ffmpegImage": {
          "type": "string"
        },
        "geminiSecret": {
          "type": "string"
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "managementCluster",
    "gitops",
    "image",
    "operator",
    "api",
    "ui",
    "mcp"
  ],
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Repository under image.registry."
        },
        "tag": {
          "type": "string",
          "description": "Tag; empty means the chart appVersion."
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$",
          "description": "Digest; when set renders repo:tag@digest."
        }
      },
      "required": [
        "repository"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            }
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        }
      },
      "required": [
        "image",
        "replicas",
        "resources",
        "service"
      ]
    }
  }
}
