{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "infrared chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "managementCluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        }
      },
      "required": [
        "name"
      ]
    },
    "externalURL": {
      "type": "string",
      "pattern": "^(https?://.+)?$"
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the operator writes to the Installation while each field is empty.",
      "properties": {
        "edge": {
          "type": "string",
          "enum": [
            "",
            "traefik",
            "gateway"
          ],
          "description": "spec.edge (INFRARED_EDGE); empty means traefik."
        },
        "previews": {
          "type": "object",
          "additionalProperties": false,
          "description": "spec.previews (INFRARED_PREVIEWS, as JSON); empty leaves previews to a person.",
          "properties": {
            "domain": {
              "type": "string",
              "minLength": 1,
              "description": "Zone z answers at https://<z>.<domain>."
            },
            "signInURL": {
              "type": "string",
              "pattern": "^https://",
              "description": "Infrared's public URL, where preview visitors sign in."
            },
            "ingressHost": {
              "type": "string",
              "description": "The name customers point their own domains at with a CNAME."
            },
            "ingressIP": {
              "type": "string",
              "description": "The ingress's public address, for A records on root domains."
            },
            "managedRoots": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Domains Infrared manages in Cloudflare, under which any org can claim a subdomain."
            },
            "cloudflareTokenSecret": {
              "type": "string",
              "description": "A Secret in the release namespace whose api-token key may edit DNS for the managed roots."
            }
          },
          "anyOf": [
            {
              "maxProperties": 0
            },
            {
              "required": [
                "domain",
                "signInURL"
              ]
            }
          ]
        }
      }
    },
    "gitops": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "templateVersion": {
          "type": "string",
          "pattern": "^(v[0-9]+\\.[0-9]+\\.[0-9]+.*|[0-9a-f]{40})$",
          "description": "A tag of infrared-gitops-template, or a full 40-character commit SHA."
        }
      },
      "required": [
        "templateVersion"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "required": [
        "registry"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "imageCredentials": {
      "type": "object",
      "additionalProperties": false,
      "description": "The Secret named by imagePullSecrets[0], rendered when username and password are set.",
      "properties": {
        "registry": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?(:[0-9]+)?$",
          "description": "Registry host the credential is for."
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string",
          "description": "Pass it with --set-file; surrounding whitespace is trimmed."
        }
      }
    },
    "platformTokens": {
      "type": "object",
      "additionalProperties": false,
      "description": "Secret infrared-platform-tokens, rendered when a token is set.",
      "properties": {
        "cloudflareApiToken": {
          "type": "string",
          "description": "Key cloudflare-api-token. Pass it with --set-file; surrounding whitespace is trimmed."
        },
        "existingSecret": {
          "type": "string",
          "enum": [
            "",
            "infrared-platform-tokens"
          ],
          "description": "infrared-platform-tokens when it already exists; the chart then renders none."
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "description": "Setup token; empty generates one."
        },
        "existingSecret": {
          "type": "string",
          "description": "Name of an existing Secret; when set the chart renders none."
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "description": "Session key; empty generates one."
        },
        "existingSecret": {
          "type": "string",
          "description": "Name of an existing Secret; when set the chart renders none."
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            }
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extraRules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      },
      "required": [
        "image",
        "replicas",
        "resources",
        "service"
      ]
    },
    "api": {
      "$ref": "#/$defs/component"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            }
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "extensions": {
          "type": "array",
          "description": "Extensions the UI shows in its rail and proxies at /ext/<id>/<path>/; empty leaves the slot off.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,30}$",
                "description": "Names the routes /x/<id>/ and /ext/<id>/; '-' becomes '_' in nginx names."
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Rail label."
              },
              "icon": {
                "type": "string",
                "enum": [
                  "puzzle",
                  "book",
                  "wallet",
                  "receipt",
                  "users",
                  "key",
                  "landmark",
                  "scroll"
                ],
                "description": "Rail icon; default puzzle."
              },
              "upstream": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)+:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                "description": "host:port of the extension's Service; the host is a fully qualified name (it contains a dot), e.g. ledger.ledger.svc.cluster.local:8080."
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
                },
                "description": "First path segments proxied from /ext/<id>/<path>/ to <upstream>/<path>/; default [v1, ui]."
              },
              "entry": {
                "type": "string",
                "pattern": "^(/ext/[a-z][a-z0-9-]{1,30}/ui(/[A-Za-z0-9_~-][A-Za-z0-9._~-]*)+)?$",
                "description": "Absolute path of the remote module under /ext/<id>/ui/; empty means /ext/<id>/ui/entry.js."
              }
            },
            "required": [
              "id",
              "title",
              "upstream"
            ]
          }
        },
        "extensionsProxySecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string",
              "description": "Secret whose value the UI sends to extension upstreams as X-Infrared-Proxy-Secret; required when extensions is not empty."
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "image",
        "replicas",
        "resources",
        "service"
      ]
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            }
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "token": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "image",
        "replicas",
        "resources",
        "service"
      ]
    },
    "builds": {
      "type": "object",
      "additionalProperties": false,
      "description": "Product builds with kpack.",
      "properties": {
        "registry": {
          "type": "string",
          "description": "Registry prefix product images are built into; empty disables the builds component."
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "goToolchainImage": {
          "type": "string",
          "minLength": 1
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Fence runner pods with a NetworkPolicy."
            },
            "extraEgressCIDRs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
              },
              "description": "Private CIDRs runners may reach over HTTP(S)."
            }
          }
        },
        "helmImage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metricsURL": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "managementCluster",
    "gitops",
    "image",
    "operator",
    "api",
    "ui",
    "mcp"
  ],
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "Repository under image.registry."
        },
        "tag": {
          "type": "string",
          "description": "Tag; empty means the chart appVersion."
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$",
          "description": "Digest; when set renders repo:tag@digest."
        }
      },
      "required": [
        "repository"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            }
          }
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        }
      },
      "required": [
        "image",
        "replicas",
        "resources",
        "service"
      ]
    }
  }
}
